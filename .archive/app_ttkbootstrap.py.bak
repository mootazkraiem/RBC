"""
Release Knowledge Capture - Phase 1 desktop prototype (full Python).

Stack: ttkbootstrap (themed tkinter -- stdlib GUI toolkit, no browser
engine, no native binary download) + sqlite3 (stdlib) for storage. No
HTML, no network calls, no cloud, no external AI -- everything runs in a
single local process. ttkbootstrap is the one third-party dependency: a
pure-Python theming layer on top of tkinter, not a separate runtime.

Run:
    pip install -r requirements.txt
    python app.py
"""

import tkinter as tk

import ttkbootstrap as tb
from ttkbootstrap.constants import BOTH, E, LEFT, RIGHT, W, X, YES
from ttkbootstrap.dialogs import Messagebox, Querybox

from seed import DEFAULT_APPLICATIONS, SEED_ISSUES
from store import IssueStore, app_data_dir

THEME = "cosmo"

STATUS_BOOTSTYLE = {
    "solved": "success",
    "review": "warning",
    "draft": "secondary",
    "critical": "danger",
}
STATUS_LABEL = {"solved": "SOLVED", "review": "REVIEW", "draft": "DRAFT", "critical": "CRITICAL"}
STATUS_ORDER = ["draft", "review", "solved", "critical"]
NEW_APP_SENTINEL = "+ New application…"
ADD_APP_PLACEHOLDER = "+ Add application…"

FONT = "Segoe UI"


def status_role(status):
    return STATUS_BOOTSTYLE.get(status, "secondary")


def tint(hex_color, factor=0.85):
    """Blend a theme color toward white for pastel badge/chip backgrounds."""
    hex_color = hex_color.lstrip("#")
    r, g, b = int(hex_color[0:2], 16), int(hex_color[2:4], 16), int(hex_color[4:6], 16)
    r = int(r + (255 - r) * factor)
    g = int(g + (255 - g) * factor)
    b = int(b + (255 - b) * factor)
    return f"#{r:02x}{g:02x}{b:02x}"


class AppPicker:
    """Chips + combobox widget for picking a set of application names.

    Reused by both the capture form and the issue-edit dialog so the
    "involved applications" UI (and its "+ New application…" flow) only
    exists once.
    """

    def __init__(self, app, parent, initial=None):
        self.app = app
        self.selected = list(initial or [])

        self.chips_frame = tk.Frame(parent, bg=app.card, highlightbackground=app.border,
                                     highlightthickness=1)
        self.chips_frame.pack(fill=X, ipady=4)
        self.var = tk.StringVar()
        self.combo = tb.Combobox(parent, textvariable=self.var, state="readonly", font=(FONT, 9))
        self.combo.pack(fill=X, pady=(6, 0))
        self.combo.bind("<<ComboboxSelected>>", self._on_select)

        app.app_pickers.append(self)
        self.refresh_values()
        self.render_chips()

    def refresh_values(self):
        if not self.combo.winfo_exists():
            return
        self.combo["values"] = [ADD_APP_PLACEHOLDER] + self.app.all_apps + [NEW_APP_SENTINEL]
        self.var.set(ADD_APP_PLACEHOLDER)

    def _on_select(self, event=None):
        value = self.var.get()
        if value == NEW_APP_SENTINEL:
            name = self.app._open_add_app_dialog(parent=self.chips_frame.winfo_toplevel())
            if name:
                self.add(name)
        elif value and value != ADD_APP_PLACEHOLDER:
            self.add(value)
        self.var.set(ADD_APP_PLACEHOLDER)

    def add(self, name):
        if name not in self.selected:
            self.selected.append(name)
            self.render_chips()

    def remove(self, name):
        self.selected = [a for a in self.selected if a != name]
        self.render_chips()

    def render_chips(self):
        for child in self.chips_frame.winfo_children():
            child.destroy()
        chip_bg = tint(self.app.colors.primary, 0.85)
        for idx, name in enumerate(self.selected):
            chip = tk.Frame(self.chips_frame, bg=chip_bg)
            chip.grid(row=idx // 3, column=idx % 3, padx=4, pady=4, sticky="w")
            tk.Label(chip, text=name, bg=chip_bg, fg=self.app.colors.primary, font=(FONT, 9)).pack(
                side=LEFT, padx=(8, 2), pady=3)
            tk.Button(chip, text="×", bg=chip_bg, fg=self.app.colors.primary, bd=0,
                      font=(FONT, 9, "bold"), cursor="hand2", activebackground=chip_bg,
                      command=lambda a=name: self.remove(a)).pack(side=LEFT, padx=(0, 6))


class StepList:
    """Dynamic list of (action, application) step rows, add/remove/reorder."""

    def __init__(self, app, container):
        self.app = app
        self.container = container
        self.rows = []
        app.step_lists.append(self)

    def add(self, action="", app_val=""):
        row_frame = tk.Frame(self.container, bg=self.app.card)
        row_frame.pack(fill=X, pady=3)

        num_label = tk.Label(row_frame, text="", width=2, bg=self.app.colors.primary, fg="white",
                              font=(FONT, 8, "bold"))
        num_label.pack(side=LEFT, padx=(0, 8))

        action_entry = tb.Entry(row_frame, font=(FONT, 9))
        action_entry.insert(0, action)
        action_entry.pack(side=LEFT, fill=X, expand=YES, padx=(0, 8))

        app_var = tk.StringVar(value=app_val)
        app_combo = tb.Combobox(row_frame, textvariable=app_var, state="readonly",
                                 width=18, font=(FONT, 9))
        app_combo["values"] = [""] + self.app.all_apps + [NEW_APP_SENTINEL]
        app_combo.pack(side=LEFT, padx=(0, 8))

        del_btn = tb.Button(row_frame, text="✕", width=3, bootstyle="danger-outline",
                             command=lambda: self.delete(row_frame))
        del_btn.pack(side=LEFT)

        entry = {"frame": row_frame, "action_entry": action_entry, "app_var": app_var, "app_combo": app_combo}
        app_combo.bind("<<ComboboxSelected>>", lambda e, ent=entry: self._on_app_selected(ent))

        self.rows.append(entry)
        self.renumber()

    def _on_app_selected(self, entry):
        if entry["app_var"].get() == NEW_APP_SENTINEL:
            name = self.app._open_add_app_dialog(parent=self.container.winfo_toplevel())
            entry["app_var"].set(name or "")

    def delete(self, row_frame):
        self.rows = [r for r in self.rows if r["frame"] is not row_frame]
        row_frame.destroy()
        self.renumber()

    def renumber(self):
        for idx, row in enumerate(self.rows, start=1):
            row["frame"].winfo_children()[0].config(text=str(idx))

    def refresh_app_values(self):
        for row in self.rows:
            if not row["app_combo"].winfo_exists():
                continue
            current = row["app_var"].get()
            row["app_combo"]["values"] = [""] + self.app.all_apps + [NEW_APP_SENTINEL]
            row["app_var"].set(current)

    def collect(self):
        steps = []
        for row in self.rows:
            action = row["action_entry"].get().strip()
            app_val = row["app_var"].get()
            if app_val == NEW_APP_SENTINEL:
                app_val = ""
            if action:
                steps.append([action, app_val])
        return steps

    def clear(self):
        for row in list(self.rows):
            row["frame"].destroy()
        self.rows = []


class App:
    def __init__(self):
        self.root = tb.Window(
            title="Release Knowledge Capture (Local Prototype)",
            themename=THEME,
            size=(1360, 900),
            minsize=(1040, 720),
        )
        self.colors = self.root.style.colors
        self.card = self.colors.bg
        self.muted = self.colors.secondary
        self.border = self.colors.border
        self.page_bg = tint(self.colors.secondary, 0.96)
        self.root.configure(background=self.page_bg)

        self.db_path = app_data_dir() / "issues.db"
        self.store = IssueStore(self.db_path)
        self.store.seed_if_empty(SEED_ISSUES)
        self.store.seed_applications_if_empty(DEFAULT_APPLICATIONS)

        self.all_apps = []
        self.app_pickers = []
        self.step_lists = []

        self._build_ui()
        self._load_applications()
        self._render_issue_list()
        self._clear_form()

    def run(self):
        self.root.mainloop()

    # ------------------------------------------------------------ top-level
    def _build_ui(self):
        header = tk.Frame(self.root, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        header.pack(fill=X)
        brand_inner = tk.Frame(header, bg=self.card)
        brand_inner.pack(side=LEFT, padx=24, pady=14)
        tb.Label(brand_inner, text="Release Knowledge Capture", background=self.card,
                 font=(FONT, 15, "bold")).pack(side=LEFT)
        tk.Label(brand_inner, text="PROTOTYPE — LOCAL ONLY", bg=self.colors.primary, fg="white",
                 font=(FONT, 8, "bold"), padx=9, pady=3).pack(side=LEFT, padx=(12, 0))

        search_frame = tk.Frame(header, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        search_frame.pack(side=LEFT, expand=YES, fill=X, padx=24)
        tk.Label(search_frame, text="🔍", bg=self.card, fg=self.muted, font=(FONT, 10)).pack(
            side=LEFT, padx=(10, 0))
        self.search_var = tk.StringVar()
        search_entry = tb.Entry(search_frame, textvariable=self.search_var, font=(FONT, 10),
                                 bootstyle="light")
        search_entry.pack(side=LEFT, fill=X, expand=YES, ipady=5, padx=(6, 6))
        self._set_placeholder(search_entry, "Search knowledge base…")
        self.search_var.trace_add("write", lambda *_: self._render_issue_list(self.search_var.get()))

        banner = tk.Label(
            self.root, bg=tint(self.colors.info, 0.9), fg="#3d2b6e",
            wraplength=1300, justify=LEFT, padx=16, pady=11, font=(FONT, 9),
            text=("ℹ  Phase 1 prototype. Data is stored locally on this machine only (no server, no "
                  "cloud, no external AI). Not yet connected to PDM, Active Directory, or SharePoint — "
                  "see the architecture assessment for what's required before a real pilot."),
        )
        banner.pack(fill=X, padx=24, pady=(16, 8))

        main = tk.Frame(self.root, bg=self.page_bg)
        main.pack(fill=BOTH, expand=YES, padx=24, pady=(0, 12))
        main.columnconfigure(0, weight=3)
        main.columnconfigure(1, weight=1, minsize=330)
        main.rowconfigure(0, weight=1)

        self._build_capture_card(main)
        self._build_sidebar(main)

        tk.Label(self.root, bg=self.page_bg, fg=self.muted, font=(FONT, 8),
                 text="Release Knowledge Capture — desktop prototype (Python + ttkbootstrap, local storage "
                      "only). No cloud services, external AI, or production systems are used.").pack(pady=10)

    def _set_placeholder(self, entry, text):
        entry.insert(0, text)
        entry.configure(foreground=self.muted)

        def on_focus_in(event):
            if entry.get() == text:
                entry.delete(0, "end")
                entry.configure(foreground=self.colors.fg)

        def on_focus_out(event):
            if not entry.get():
                entry.insert(0, text)
                entry.configure(foreground=self.muted)

        entry.bind("<FocusIn>", on_focus_in)
        entry.bind("<FocusOut>", on_focus_out)

    def _separator(self, parent):
        tb.Separator(parent, bootstyle="secondary").pack(fill=X, pady=(16, 14))

    # -------------------------------------------------------- capture form
    def _build_capture_card(self, parent):
        outer = tk.Frame(parent, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        outer.grid(row=0, column=0, sticky="nsew", padx=(0, 18))

        form = tb.ScrolledFrame(outer, autohide=False)
        form.pack(fill=BOTH, expand=YES, padx=24, pady=22)

        head = tk.Frame(form, bg=self.card)
        head.pack(fill=X)
        title_box = tk.Frame(head, bg=self.card)
        title_box.pack(side=LEFT)
        tb.Label(title_box, text="Capture New Release Issue", background=self.card,
                 font=(FONT, 14, "bold")).pack(anchor=W)
        tk.Label(title_box, text="Record a resolved issue to help the team and improve our knowledge base.",
                 bg=self.card, fg=self.muted, font=(FONT, 9)).pack(anchor=W, pady=(2, 0))
        self.ref_label = tk.Label(head, text="REF-…", bg=tint(self.colors.primary, 0.85),
                                   fg=self.colors.primary, font=(FONT, 9, "bold"), padx=11, pady=4)
        self.ref_label.pack(side=RIGHT, anchor="n")

        self._separator(form)

        self._field_label(form, "Issue Title *")
        self.title_entry = tb.Entry(form, font=(FONT, 10))
        self.title_entry.pack(fill=X, ipady=4, pady=(0, 12))

        row2 = tk.Frame(form, bg=self.card)
        row2.pack(fill=X, pady=(0, 12))
        row2.columnconfigure(0, weight=1)
        row2.columnconfigure(1, weight=1)

        left_col = tk.Frame(row2, bg=self.card)
        left_col.grid(row=0, column=0, sticky="nsew", padx=(0, 12))
        self._field_label(left_col, "Error Code")
        self.error_entry = tb.Entry(left_col, font=(FONT, 10))
        self.error_entry.pack(fill=X, ipady=4)

        right_col = tk.Frame(row2, bg=self.card)
        right_col.grid(row=0, column=1, sticky="nsew")
        self._field_label(right_col, "Applications Involved *")
        self.app_picker = AppPicker(self, right_col)

        self._field_label(form, "Problem Description *")
        self.problem_st = tb.ScrolledText(form, height=4, autohide=False)
        self.problem_st.pack(fill=X)
        self.problem_count = tk.Label(form, text="0 / 3000", bg=self.card, fg=self.muted, font=(FONT, 8))
        self.problem_count.pack(anchor=E, pady=(3, 12))
        self._bind_charcount(self.problem_st.text, self.problem_count, 3000)

        row3 = tk.Frame(form, bg=self.card)
        row3.pack(fill=X, pady=(0, 12))
        row3.columnconfigure(0, weight=1)
        row3.columnconfigure(1, weight=1)

        root_col = tk.Frame(row3, bg=self.card)
        root_col.grid(row=0, column=0, sticky="nsew", padx=(0, 12))
        self._field_label(root_col, "Root Cause *")
        self.root_st = tb.ScrolledText(root_col, height=3, autohide=False)
        self.root_st.pack(fill=X)
        self.root_count = tk.Label(root_col, text="0 / 2000", bg=self.card, fg=self.muted, font=(FONT, 8))
        self.root_count.pack(anchor=E, pady=(3, 0))
        self._bind_charcount(self.root_st.text, self.root_count, 2000)

        sol_col = tk.Frame(row3, bg=self.card)
        sol_col.grid(row=0, column=1, sticky="nsew")
        self._field_label(sol_col, "Resolution / Solution *")
        self.solution_st = tb.ScrolledText(sol_col, height=3, autohide=False)
        self.solution_st.pack(fill=X)
        self.solution_count = tk.Label(sol_col, text="0 / 2000", bg=self.card, fg=self.muted, font=(FONT, 8))
        self.solution_count.pack(anchor=E, pady=(3, 0))
        self._bind_charcount(self.solution_st.text, self.solution_count, 2000)

        self._separator(form)

        self._field_label(form, "Step-by-Step Procedure *")
        steps_outer = tk.Frame(form, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        steps_outer.pack(fill=X)
        steps_head = tk.Frame(steps_outer, bg=tint(self.colors.secondary, 0.92))
        steps_head.pack(fill=X)
        tk.Label(steps_head, text="STEP", bg=tint(self.colors.secondary, 0.92), fg=self.muted,
                 font=(FONT, 8, "bold"), width=4).pack(side=LEFT, padx=8, pady=6)
        tk.Label(steps_head, text="ACTION", bg=tint(self.colors.secondary, 0.92), fg=self.muted,
                 font=(FONT, 8, "bold")).pack(side=LEFT, padx=6, pady=6)
        self.steps_container = tk.Frame(steps_outer, bg=self.card)
        self.steps_container.pack(fill=X, padx=8, pady=8)
        self.step_list = StepList(self, self.steps_container)

        tb.Button(form, text="+ Add Step", bootstyle="link",
                  command=lambda: self.step_list.add()).pack(anchor=W, pady=(8, 20))

        actions = tk.Frame(form, bg=self.card)
        actions.pack(fill=X)
        tb.Button(actions, text="Submit to Knowledge Base", bootstyle="primary",
                  command=lambda: self._submit_issue("review")).pack(side=LEFT, ipadx=6, ipady=2)
        tb.Button(actions, text="Save Draft", bootstyle="secondary-outline",
                  command=lambda: self._submit_issue("draft")).pack(side=LEFT, padx=10, ipady=2)
        tb.Button(actions, text="Clear form", bootstyle="link", command=self._clear_form).pack(side=LEFT)

    def _field_label(self, parent, text):
        box = tk.Frame(parent, bg=self.card)
        box.pack(fill=X, pady=(0, 6))
        required = text.endswith("*")
        base_text = text[:-1].rstrip() if required else text
        tk.Label(box, text=base_text, bg=self.card, fg=self.colors.fg, font=(FONT, 9, "bold")).pack(
            side=LEFT)
        if required:
            tk.Label(box, text=" *", bg=self.card, fg=self.colors.danger, font=(FONT, 9, "bold")).pack(
                side=LEFT)

    def _bind_charcount(self, text_widget, count_label, maxlen):
        def on_change(event=None):
            content = text_widget.get("1.0", "end-1c")
            if len(content) > maxlen:
                content = content[:maxlen]
                text_widget.delete("1.0", "end")
                text_widget.insert("1.0", content)
            count_label.config(text=f"{len(content)} / {maxlen}")

        text_widget.bind("<KeyRelease>", on_change)

    # ------------------------------------------------------------- sidebar
    def _build_sidebar(self, parent):
        sidebar = tk.Frame(parent, bg=self.page_bg)
        sidebar.grid(row=0, column=1, sticky="nsew")
        sidebar.rowconfigure(0, weight=1)

        issues_card = tk.Frame(sidebar, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        issues_card.pack(fill=BOTH, expand=YES)
        head = tk.Frame(issues_card, bg=self.card)
        head.pack(fill=X, padx=16, pady=(16, 8))
        tb.Label(head, text="Recent Issues", background=self.card, font=(FONT, 13, "bold")).pack(side=LEFT)
        refresh = tk.Label(head, text="↻ Refresh", bg=self.card, fg=self.colors.primary,
                            font=(FONT, 8, "bold"), cursor="hand2")
        refresh.pack(side=RIGHT)
        refresh.bind("<Button-1>", lambda e: self._render_issue_list(self.search_var.get()))
        refresh.bind("<Enter>", lambda e: refresh.configure(fg=self.colors.get("info")))
        refresh.bind("<Leave>", lambda e: refresh.configure(fg=self.colors.primary))

        tb.Separator(issues_card, bootstyle="secondary").pack(fill=X, padx=16)

        list_scroll = tb.ScrolledFrame(issues_card, autohide=False)
        list_scroll.pack(fill=BOTH, expand=YES, padx=14, pady=(8, 8))
        self.issue_list_container = list_scroll

        tk.Label(issues_card, bg=tint(self.colors.info, 0.9), fg="#3d2b6e", wraplength=290, justify=LEFT,
                 padx=12, pady=11, font=(FONT, 9),
                 text=("Can't find your issue? Try the search bar above — it searches titles, error codes, "
                       "root causes, and resolutions stored on this machine.")).pack(fill=X, padx=16,
                                                                                       pady=(0, 16))

        data_card = tk.Frame(sidebar, bg=self.card, highlightbackground=self.border, highlightthickness=1)
        data_card.pack(fill=X, pady=(18, 0))
        tb.Label(data_card, text="Local data location", background=self.card,
                 font=(FONT, 13, "bold")).pack(anchor=W, padx=16, pady=(16, 8))
        tk.Label(data_card, text=str(self.db_path), bg=self.card, fg=self.muted, font=(FONT, 8),
                 wraplength=290, justify=LEFT, anchor=W).pack(fill=X, padx=16, pady=(0, 16))

    # --------------------------------------------------------- issue list
    def _render_issue_list(self, query=None):
        for child in self.issue_list_container.winfo_children():
            child.destroy()
        placeholder = "Search knowledge base…"
        items = self.store.search(query) if query and query.strip() and query != placeholder \
            else self.store.list_issues()
        shown = list(reversed(items))[:8]
        if not shown:
            tk.Label(self.issue_list_container, text="No matching issues.", bg=self.card, fg=self.muted,
                     font=(FONT, 9)).pack(anchor=W, pady=10)
            return
        for issue in shown:
            self._render_issue_card(issue)

    def _render_issue_card(self, issue):
        role = status_role(issue["status"])
        role_color = getattr(self.colors, role)
        hover_bg = tint(self.colors.secondary, 0.93)

        card = tk.Frame(self.issue_list_container, bg=self.card, cursor="hand2")
        card.pack(fill=X, pady=4)
        border = tk.Frame(card, width=3, bg=role_color)
        border.pack(side=LEFT, fill="y")
        content = tk.Frame(card, bg=self.card)
        content.pack(side=LEFT, fill=BOTH, expand=YES, padx=(10, 8), pady=9)

        top = tk.Frame(content, bg=self.card)
        top.pack(fill=X)
        id_lbl = tk.Label(top, text=issue["id"], bg=self.card, fg=self.colors.primary, font=(FONT, 9, "bold"))
        id_lbl.pack(side=LEFT)
        tk.Label(top, text=STATUS_LABEL.get(issue["status"], issue["status"].upper()),
                 bg=tint(role_color, 0.85), fg=role_color, font=(FONT, 7, "bold"), padx=7, pady=2).pack(
            side=RIGHT)

        title_lbl = tk.Label(content, text=issue["title"], bg=self.card, fg=self.colors.fg,
                              font=(FONT, 9, "bold"), anchor=W, justify=LEFT, wraplength=250)
        title_lbl.pack(fill=X, pady=(4, 0))
        sys_lbl = tk.Label(content, text=f"System: {issue.get('system') or '—'}", bg=self.card,
                            fg=self.muted, font=(FONT, 8), anchor=W)
        sys_lbl.pack(fill=X, pady=(1, 0))

        hover_targets = [card, content, top, id_lbl, title_lbl, sys_lbl]

        def on_enter(e):
            for w in hover_targets:
                w.configure(bg=hover_bg)

        def on_leave(e):
            for w in hover_targets:
                w.configure(bg=self.card)

        for w in hover_targets + [border]:
            w.bind("<Button-1>", lambda e, i=issue["id"]: self._open_detail(i))
        for w in hover_targets:
            w.bind("<Enter>", on_enter)
            w.bind("<Leave>", on_leave)

    # ------------------------------------------------------- issue detail
    def _open_detail(self, issue_id):
        issue = self.store.get_issue(issue_id)
        if not issue:
            Messagebox.show_error(f"No issue found with id {issue_id}.", title="Not found", parent=self.root)
            return

        state = {"issue": issue, "editing": False}
        dialog = tb.Toplevel(title=issue["id"])
        dialog.geometry("680x680")
        dialog.minsize(560, 480)
        dialog.transient(self.root)
        self._center_window(dialog)
        bg = dialog.style.colors.bg

        head = tk.Frame(dialog, bg=bg)
        head.pack(fill=X, padx=22, pady=(18, 0))
        id_status = tk.Frame(head, bg=bg)
        id_status.pack(side=LEFT)
        id_lbl = tk.Label(id_status, text=issue["id"], bg=bg, fg=self.colors.primary, font=(FONT, 10, "bold"))
        id_lbl.pack(side=LEFT)
        status_badge = tk.Label(id_status, font=(FONT, 8, "bold"), padx=8, pady=2)
        status_badge.pack(side=LEFT, padx=(8, 0))

        btns = tk.Frame(head, bg=bg)
        btns.pack(side=RIGHT)
        close_btn = tb.Button(btns, text="Close", bootstyle="secondary-outline", command=dialog.destroy)
        edit_btn = tb.Button(btns, text="✎ Edit", bootstyle="primary")
        save_btn = tb.Button(btns, text="💾 Save Changes", bootstyle="success")
        cancel_btn = tb.Button(btns, text="Cancel", bootstyle="secondary-outline")

        tb.Separator(dialog, bootstyle="secondary").pack(fill=X, padx=22, pady=(14, 0))

        body = tb.ScrolledFrame(dialog, autohide=False)
        body.pack(fill=BOTH, expand=YES, padx=22, pady=14)

        view_frame = tk.Frame(body, bg=bg)
        edit_frame = tk.Frame(body, bg=bg)
        edit_widgets = {}

        def update_badge():
            role = status_role(state["issue"]["status"])
            role_color = getattr(self.colors, role)
            status_badge.configure(text=STATUS_LABEL.get(state["issue"]["status"], "").upper() or
                                    state["issue"]["status"].upper(),
                                    bg=tint(role_color, 0.85), fg=role_color)

        def render_view():
            for w in view_frame.winfo_children():
                w.destroy()
            cur = state["issue"]

            tk.Label(view_frame, text=cur["title"], bg=bg, fg=self.colors.fg, font=(FONT, 15, "bold"),
                     wraplength=600, justify=LEFT, anchor=W).pack(fill=X, pady=(0, 8))

            meta_text = f"System: {cur.get('system') or '—'}    "
            if cur.get("error"):
                meta_text += f"Error code: {cur['error']}    "
            meta_text += f"Recorded: {cur.get('createdAt', '')}"
            tk.Label(view_frame, text=meta_text, bg=bg, fg=self.muted, font=(FONT, 8), anchor=W,
                     wraplength=600, justify=LEFT).pack(fill=X, pady=(0, 10))

            apps_frame = tk.Frame(view_frame, bg=bg)
            apps_frame.pack(fill=X, pady=(0, 14))
            for app_name in cur.get("apps", []):
                tk.Label(apps_frame, text=app_name, bg=tint(self.colors.primary, 0.85),
                         fg=self.colors.primary, font=(FONT, 8), padx=9, pady=3).pack(
                    side=LEFT, padx=(0, 6), pady=2)

            for heading, value in (
                ("Problem", cur["problem"]),
                ("Root Cause", cur["root"]),
                ("Resolution / Solution", cur["solution"]),
            ):
                tk.Label(view_frame, text=heading, bg=bg, fg=self.colors.fg, font=(FONT, 9, "bold"),
                         anchor=W).pack(fill=X, pady=(8, 3))
                tk.Label(view_frame, text=value, bg=bg, fg=self.colors.fg, font=(FONT, 9), wraplength=600,
                         justify=LEFT, anchor=W).pack(fill=X)

            tk.Label(view_frame, text="Step-by-Step Procedure", bg=bg, fg=self.colors.fg,
                     font=(FONT, 9, "bold"), anchor=W).pack(fill=X, pady=(12, 4))
            for idx, step in enumerate(cur.get("steps", []), start=1):
                action, app_name = (step + [""])[:2] if isinstance(step, list) else (step, "")
                line = f"{idx}. {action}" + (f"  ({app_name})" if app_name else "")
                tk.Label(view_frame, text=line, bg=bg, fg=self.colors.fg, font=(FONT, 9), wraplength=600,
                         justify=LEFT, anchor=W).pack(fill=X, pady=2)

        def render_edit():
            for w in edit_frame.winfo_children():
                w.destroy()
            cur = state["issue"]

            row = tk.Frame(edit_frame, bg=bg)
            row.pack(fill=X, pady=(0, 10))
            row.columnconfigure(0, weight=2)
            row.columnconfigure(1, weight=1)

            title_col = tk.Frame(row, bg=bg)
            title_col.grid(row=0, column=0, sticky="nsew", padx=(0, 12))
            self._field_label(title_col, "Issue Title *")
            title_entry = tb.Entry(title_col, font=(FONT, 10))
            title_entry.insert(0, cur["title"])
            title_entry.pack(fill=X, ipady=4)

            status_col = tk.Frame(row, bg=bg)
            status_col.grid(row=0, column=1, sticky="nsew")
            self._field_label(status_col, "Status")
            status_var = tk.StringVar(value=cur["status"])
            status_combo = tb.Combobox(status_col, textvariable=status_var, state="readonly",
                                        values=STATUS_ORDER, font=(FONT, 9))
            status_combo.pack(fill=X, ipady=1)

            self._field_label(edit_frame, "Error Code")
            error_entry = tb.Entry(edit_frame, font=(FONT, 10))
            error_entry.insert(0, cur.get("error", ""))
            error_entry.pack(fill=X, ipady=4, pady=(0, 10))

            self._field_label(edit_frame, "Applications Involved *")
            picker = AppPicker(self, edit_frame, initial=cur.get("apps", []))

            self._field_label(edit_frame, "Problem Description *")
            problem_st = tb.ScrolledText(edit_frame, height=4, autohide=False)
            problem_st.text.insert("1.0", cur["problem"])
            problem_st.pack(fill=X, pady=(0, 10))

            self._field_label(edit_frame, "Root Cause *")
            root_st = tb.ScrolledText(edit_frame, height=3, autohide=False)
            root_st.text.insert("1.0", cur["root"])
            root_st.pack(fill=X, pady=(0, 10))

            self._field_label(edit_frame, "Resolution / Solution *")
            solution_st = tb.ScrolledText(edit_frame, height=3, autohide=False)
            solution_st.text.insert("1.0", cur["solution"])
            solution_st.pack(fill=X, pady=(0, 10))

            self._field_label(edit_frame, "Step-by-Step Procedure *")
            steps_outer = tk.Frame(edit_frame, bg=bg, highlightbackground=self.border, highlightthickness=1)
            steps_outer.pack(fill=X)
            steps_container = tk.Frame(steps_outer, bg=bg)
            steps_container.pack(fill=X, padx=8, pady=8)
            step_list = StepList(self, steps_container)
            for step in cur.get("steps", []):
                action, app_name = (step + [""])[:2] if isinstance(step, list) else (step, "")
                step_list.add(action, app_name)
            tb.Button(edit_frame, text="+ Add Step", bootstyle="link",
                      command=lambda: step_list.add()).pack(anchor=W, pady=(8, 4))

            edit_widgets.update(title_entry=title_entry, status_var=status_var, error_entry=error_entry,
                                 picker=picker, problem_st=problem_st, root_st=root_st,
                                 solution_st=solution_st, step_list=step_list)

        def show_view():
            state["editing"] = False
            edit_frame.pack_forget()
            render_view()
            view_frame.pack(fill=X)
            update_badge()
            edit_btn.pack(side=RIGHT)
            save_btn.pack_forget()
            cancel_btn.pack_forget()

        def show_edit():
            state["editing"] = True
            view_frame.pack_forget()
            render_edit()
            edit_frame.pack(fill=X)
            edit_btn.pack_forget()
            cancel_btn.pack(side=RIGHT, padx=(8, 0))
            save_btn.pack(side=RIGHT)

        def do_cancel():
            show_view()

        def do_save():
            title = edit_widgets["title_entry"].get().strip()
            error = edit_widgets["error_entry"].get().strip()
            problem = edit_widgets["problem_st"].text.get("1.0", "end-1c").strip()
            root_cause = edit_widgets["root_st"].text.get("1.0", "end-1c").strip()
            solution = edit_widgets["solution_st"].text.get("1.0", "end-1c").strip()
            steps = edit_widgets["step_list"].collect()
            apps = list(edit_widgets["picker"].selected)
            status = edit_widgets["status_var"].get()

            if not title or not apps or not problem or not root_cause or not solution or not steps:
                Messagebox.show_warning(
                    "Please fill in the required fields (title, at least one application, problem, "
                    "root cause, solution, and at least one step) before saving.",
                    title="Missing required fields", parent=dialog,
                )
                return

            updated = self.store.update_issue(issue_id, {
                "title": title, "system": apps[0], "status": status, "error": error,
                "apps": apps, "problem": problem, "root": root_cause, "solution": solution,
                "steps": steps,
            })
            if updated is None:
                Messagebox.show_error("This issue no longer exists.", title="Not found", parent=dialog)
                dialog.destroy()
                return

            state["issue"] = updated
            self._render_issue_list(self.search_var.get())
            show_view()

        edit_btn.configure(command=show_edit)
        save_btn.configure(command=do_save)
        cancel_btn.configure(command=do_cancel)
        close_btn.pack(side=RIGHT, padx=(8, 0))

        show_view()
        dialog.bind("<Escape>", lambda e: (do_cancel() if state["editing"] else dialog.destroy()))

    def _center_window(self, win):
        win.update_idletasks()
        rx, ry = self.root.winfo_rootx(), self.root.winfo_rooty()
        rw, rh = self.root.winfo_width(), self.root.winfo_height()
        w, h = win.winfo_width(), win.winfo_height()
        x = rx + (rw - w) // 2
        y = ry + (rh - h) // 3
        win.geometry(f"+{max(x, 0)}+{max(y, 0)}")

    # ---------------------------------------------------------- applications
    def _load_applications(self):
        self.all_apps = self.store.list_applications()
        self._broadcast_app_list()

    def _broadcast_app_list(self):
        self.app_pickers = [p for p in self.app_pickers if p.combo.winfo_exists()]
        self.step_lists = [s for s in self.step_lists if s.container.winfo_exists()]
        for picker in self.app_pickers:
            picker.refresh_values()
        for step_list in self.step_lists:
            step_list.refresh_app_values()

    def _open_add_app_dialog(self, parent=None):
        name = Querybox.get_string(prompt="Application Name", title="Add Application",
                                    parent=parent or self.root)
        if not name or not name.strip():
            return None
        name = name.strip()
        self.all_apps = self.store.add_application(name)
        self._broadcast_app_list()
        return name

    # -------------------------------------------------------------- submit
    def _collect_form(self):
        problem = self.problem_st.text.get("1.0", "end-1c").strip()
        root_cause = self.root_st.text.get("1.0", "end-1c").strip()
        solution = self.solution_st.text.get("1.0", "end-1c").strip()
        return {
            "title": self.title_entry.get().strip(),
            "error": self.error_entry.get().strip(),
            "problem": problem,
            "root": root_cause,
            "solution": solution,
            "steps": self.step_list.collect(),
        }

    def _submit_issue(self, status):
        f = self._collect_form()
        apps = self.app_picker.selected
        if not f["title"] or not apps or not f["problem"] or not f["root"] \
                or not f["solution"] or not f["steps"]:
            Messagebox.show_warning(
                "Please fill in the required fields (title, at least one application, problem, "
                "root cause, solution, and at least one step) before submitting.",
                title="Missing required fields", parent=self.root,
            )
            return
        issue = {
            "title": f["title"],
            "system": apps[0],
            "status": status,
            "error": f["error"],
            "apps": list(apps),
            "problem": f["problem"],
            "root": f["root"],
            "solution": f["solution"],
            "steps": f["steps"],
        }
        self.store.add_issue(issue)
        self._render_issue_list(self.search_var.get())
        self._clear_form()

    def _clear_form(self):
        self.title_entry.delete(0, "end")
        self.error_entry.delete(0, "end")
        for text_widget, count_label, maxlen in (
            (self.problem_st.text, self.problem_count, 3000),
            (self.root_st.text, self.root_count, 2000),
            (self.solution_st.text, self.solution_count, 2000),
        ):
            text_widget.delete("1.0", "end")
            count_label.config(text=f"0 / {maxlen}")

        self.app_picker.selected = []
        self.app_picker.render_chips()

        self.step_list.clear()
        self.step_list.add()
        self.step_list.add()

        self.ref_label.config(text=self.store.next_ref_id())


def main():
    App().run()


if __name__ == "__main__":
    main()
